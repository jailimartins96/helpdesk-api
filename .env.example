# Variáveis de Ambiente - Helpdesk API
# Copie este arquivo para .env e configure os valores

# Porta do servidor
PORT=3000

# Ambiente
NODE_ENV=development

# Database
DB_PATH=./helpdesk-api/databasse/helpdesk.db

# JWT (IMPORTANTE: Adicione depois de implementar autenticação)
JWT_SECRET=sua_chave_secreta_muito_longa_aqui_minimo_32_caracteres
JWT_EXPIRY=24h

# CORS (IMPORTANTE: Restringir para domínios conhecidos)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Segurança
HELMET_ENABLED=true
HSTS_MAX_AGE=31536000

# Admin (depois implementar)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=senha_hash_aqui
